---
import home from '../content/home.json';
const { hero } = home;
---

<header class="nav wrap">
  <a href="#top" class="logo">
    <span class="script">Websites</span> <span>with Jeremy</span>
  </a>
  <a href="#contact" class="btn btn-primary btn-sm">{hero.primaryCta}</a>
</header>

<section id="top" class="hero section">
  <svg class="deco squiggle" width="180" height="40" viewBox="0 0 180 40" fill="none" aria-hidden="true">
    <path d="M2 20c15-18 30 18 45 0s30-18 45 0 30 18 45 0 30-18 41 0" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
  </svg>
  <svg class="deco ring" width="120" height="120" viewBox="0 0 120 120" fill="none" aria-hidden="true">
    <circle cx="60" cy="60" r="58" stroke="currentColor" stroke-width="2" />
  </svg>
  <svg class="deco dots" width="96" height="96" viewBox="0 0 96 96" aria-hidden="true">
    <pattern id="dotgrid" width="16" height="16" patternUnits="userSpaceOnUse">
      <circle cx="3" cy="3" r="2" fill="currentColor" />
    </pattern>
    <rect width="96" height="96" fill="url(#dotgrid)" />
  </svg>

  <div class="wrap">
    <h1>
      <span class="rotator script" aria-live="polite">
        {hero.words.map((word, i) => <span class:list={['word', { active: i === 0 }]}>{word}</span>)}
      </span>
      <span class="name">with Jeremy</span>
    </h1>

    <p class="lede">{hero.sub}</p>

    <div class="actions">
      <a href="#contact" class="btn btn-primary">{hero.primaryCta} →</a>
      <a href="#work" class="btn btn-ghost">{hero.secondaryCta}</a>
    </div>

    <ul class="trust">
      {hero.trust.map((point) => <li>{point}</li>)}
    </ul>
  </div>
</section>

<style>
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 20px;
  }

  .logo {
    text-decoration: none;
    font-weight: 700;
    letter-spacing: -0.02em;
    font-size: 1.1rem;
    white-space: nowrap;
  }

  .logo .script {
    font-size: 1.4rem;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--blue);
  }

  .btn-sm {
    padding: 10px 18px;
    font-size: 0.9rem;
    white-space: nowrap;
  }

  @media (max-width: 420px) {
    .logo {
      font-size: 0.95rem;
    }
    .logo .script {
      font-size: 1.2rem;
    }
    .btn-sm {
      padding: 8px 14px;
      font-size: 0.85rem;
    }
  }

  .hero {
    overflow: hidden;
    padding-top: clamp(48px, 8vw, 96px);
  }

  h1 {
    font-size: clamp(3rem, 10vw, 7.5rem);
    letter-spacing: -0.045em;
    line-height: 0.95;
    margin-bottom: 28px;
  }

  .rotator {
    display: grid;
    /* One line per word: words share a grid cell, so a wrapped word would leave
       a blank line under the short ones. 8.8 ≈ width of "Google reviews" in ems. */
    font-size: min(1.2em, calc((100vw - 2 * var(--gutter)) / 8.8));
    white-space: nowrap;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.15;
    color: var(--blue);
  }

  /* Each word writes on left to right, like a pen stroke; the old one fades out */
  .word {
    grid-area: 1 / 1;
    /* Hand-placed feel: --tilt and --nudge are re-rolled each time a word shows */
    transform: translateX(var(--nudge, 0px)) rotate(var(--tilt, -1.5deg));
    transform-origin: left bottom;
    opacity: 0;
    clip-path: inset(-20% 100% -20% 0);
    transition: opacity 0.3s ease, clip-path 0s 0.3s;
  }

  .word.active {
    opacity: 1;
    clip-path: inset(-20% -10% -20% 0);
    transition: clip-path 1.2s cubic-bezier(0.6, 0, 0.3, 1);
  }

  .name {
    display: block;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  .trust {
    list-style: none;
    padding: 0;
    margin: 40px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    font-size: 0.95rem;
    color: var(--muted);
  }

  .trust li::before {
    content: '✓';
    color: var(--blue);
    font-weight: 700;
    margin-right: 8px;
  }

  .squiggle {
    top: 18%;
    right: 6%;
    color: var(--blue);
    opacity: 0.35;
  }

  .ring {
    bottom: 10%;
    right: 14%;
  }

  .dots {
    top: 8%;
    right: 26%;
  }

  @media (max-width: 720px) {
    .ring,
    .dots {
      display: none;
    }
    .squiggle {
      top: 4%;
      right: -40px;
    }
  }
</style>

<script>
  const words = document.querySelectorAll<HTMLElement>('.rotator .word');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const between = (min: number, max: number) => min + Math.random() * (max - min);

  // 1–2° uphill only, and a few px off the left edge, so no two words sit the same
  function place(word: HTMLElement) {
    const tilt = -between(1, 2);
    word.style.setProperty('--tilt', `${tilt.toFixed(2)}deg`);
    word.style.setProperty('--nudge', `${between(-4, 10).toFixed(1)}px`);
  }

  words.forEach(place);
  if (words.length > 1 && !reduce) {
    let i = 0;
    setInterval(() => {
      words[i].classList.remove('active');
      i = (i + 1) % words.length;
      place(words[i]);
      words[i].classList.add('active');
    }, 2600);
  }
</script>
