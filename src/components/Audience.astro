---
import home from '../content/home.json';
const { audience } = home;
---

<section class="section audience">
  <div class="wrap">
    <h2>{audience.heading}</h2>
    <ul class="chips">
      {audience.trades.map((trade) => <li class="chip">{trade}</li>)}
    </ul>
    <p class="label">{audience.suburbsLabel}</p>
    <p class="suburbs">
      {audience.suburbs.map((suburb) => <span>{suburb}</span>)}
    </p>
  </div>
</section>

<style>
  .audience {
    padding-block: clamp(48px, 7vw, 88px);
  }

  .chips {
    list-style: none;
    padding: 0;
    margin: 28px 0 40px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .label {
    color: var(--muted);
    font-size: 0.95rem;
    margin-bottom: 8px;
  }

  .suburbs {
    font-size: clamp(1.25rem, 2.6vw, 1.75rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.4;
  }

  .suburbs span:not(:last-child)::after {
    content: ' · ';
    color: var(--blue);
  }
</style>
